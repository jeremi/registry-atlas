@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix person: <https://example.org/vocab/person#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/shapes/person>
  a sh:NodeShape ;
  dct:title "Person shape graph" ;
  dct:conformsTo <https://semiceu.github.io/Core-Person-Vocabulary/releases/2.1.1/> ;
  sh:targetClass person:Person ;
  sh:property [
    a sh:PropertyShape ;
    sh:path foaf:name ;
    sh:name "full name" ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path person:dateOfBirth ;
    sh:datatype xsd:date ;
    sh:maxCount 1
  ] .
