{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/person.schema.json",
  "title": "Person",
  "description": "Hypothetical person record schema for discovery parser tests.",
  "type": "object",
  "required": ["id", "name"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uri",
      "description": "Stable person identifier."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "birthDate": {
      "type": "string",
      "format": "date"
    }
  },
  "additionalProperties": false
}
