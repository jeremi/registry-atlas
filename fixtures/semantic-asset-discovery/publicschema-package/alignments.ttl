@prefix dct: <http://purl.org/dc/terms/> .
@prefix experson: <https://example.org/publicschema/person#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://example.org/publicschema/person/alignment>
  a skos:ConceptScheme ;
  dct:title "Example person alignment" ;
  dct:description "Hypothetical alignment metadata for parser tests." .

experson:Person
  skos:exactMatch foaf:Person ;
  owl:equivalentClass <https://schema.org/Person> .

experson:name
  skos:exactMatch foaf:name .
