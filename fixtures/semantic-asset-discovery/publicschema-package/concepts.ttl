@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://example.org/publicschema/person/status>
  a skos:ConceptScheme ;
  dct:title "Person status concepts" ;
  skos:hasTopConcept
    <https://example.org/publicschema/person/status/draft>,
    <https://example.org/publicschema/person/status/stable> .

<https://example.org/publicschema/person/status/draft>
  a skos:Concept ;
  skos:prefLabel "Draft"@en ;
  skos:topConceptOf <https://example.org/publicschema/person/status> .

<https://example.org/publicschema/person/status/stable>
  a skos:Concept ;
  skos:prefLabel "Stable"@en ;
  skos:topConceptOf <https://example.org/publicschema/person/status> .
